{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>tomasbjerre/renovate-config//org-inherited-config"],
  "packageRules": [
    {
      // Wisp-specific pin. Grouping (Kotlin, Compose compiler, KSP) comes from the org
      // config, but grouping only combines updates that are due at the same time — it
      // doesn't stop any member from being proposed alone. KSP 2.3.12 expects a Kotlin
      // Gradle Plugin API that this project's pinned Kotlin 2.0.21 doesn't have, and KSP
      // hasn't published a build against Kotlin 2.4.x yet. `recreateWhen: never`
      // overrides the org config's `recreateWhen: always`, which would otherwise reopen
      // a closed PR despite `enabled: false`. Re-enable all three once KSP publishes a
      // build for the Kotlin version being proposed. (The deprecated
      // `kotlinOptions { jvmTarget }` DSL is already migrated in
      // android/app/build.gradle.kts, so the Kotlin 2.4 side is ready.)
      "matchPackageNames": [
        "org.jetbrains.kotlin.android",
        "org.jetbrains.kotlin.plugin.compose",
        "com.google.devtools.ksp"
      ],
      "enabled": false,
      "recreateWhen": "never"
    },
    {
      // Deliberately pinned below its own latest release: kotlinx-coroutines-test
      // 1.10+ requires a newer Kotlin compiler (2.1+) than this project's pinned
      // Kotlin 2.0.21 — see android/app/build.gradle.kts. It must be raised by hand
      // together with a Kotlin upgrade.
      "matchPackageNames": ["org.jetbrains.kotlinx:kotlinx-coroutines-test"],
      "enabled": false,
      "recreateWhen": "never"
    },
    {
      // play-services-location 21.4.0's jar carries Kotlin metadata binary version
      // 2.3.0, newer than this project's pinned Kotlin 2.0.21 compiler can read. Must
      // go up together with a Kotlin upgrade, like kotlinx-coroutines-test above.
      "matchPackageNames": ["com.google.android.gms:play-services-location"],
      "enabled": false,
      "recreateWhen": "never"
    }
  ]
}
